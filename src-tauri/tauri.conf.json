{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FilmOrganizer",
  "version": "../package.json",
  "identifier": "io.github.nachobust.filmorganizer",
  "build": {
    "beforeDevCommand": "npm run notices && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run notices && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FilmOrganizer",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:*; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "nachobust",
    "copyright": "© 2026 nachobust · MIT License",
    "category": "Video",
    "shortDescription": "Film breakdown and scheduling",
    "longDescription": "Break a screenplay or brief down scene by scene, then schedule the shoot on a calendar and stripboard. Works offline.",
    "license": "MIT",
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExMTFEREZFODQ1Q0RBQ0EKUldUSzJseUUvdDBSRWRBa25hcDZYOW80SmhlUEg3VkJRSFY2RlpUK2JhT3ZwbFJJd3dYdDV2TlUK",
      "endpoints": [
        "https://github.com/nachobust/FilmOrganizer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
